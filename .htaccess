# QIP — root .htaccess (Windows/XAMPP safe)

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny direct browser access to sensitive folders
    RewriteRule ^(config|includes|sql|vendor)/ - [F,L]
</IfModule>

# Block dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddDefaultCharset UTF-8